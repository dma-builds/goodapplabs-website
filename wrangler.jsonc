{
  "name": "goodapplabs-website",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Only /updates goes through worker.js (for basic auth); everything else is served directly.
    "run_worker_first": ["/updates", "/updates/*"]
  }
}
