{
  "name": "goodapplabs-website",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Only the /updates index (basic auth) and shared Dream Jar links /d/* (open counting) go
    // through worker.js; posts and everything else are served directly.
    "run_worker_first": ["/updates", "/updates/", "/updates/index.html", "/d/*"]
  }
}
