{
  "name": "goodapplabs-website",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Only shared Dream Jar links /d/* (open counting), the subscription API /api/* and
    // the web version's jar pages go through worker.js; everything else is served directly.
    "run_worker_first": ["/d/*", "/api/*", "/dream-jar/try/jar/*"]
  },
  // Subscribers to /updates. Schema in migrations/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "goodapplabs-site",
      "database_id": "186dc68a-1126-4eeb-aa18-47cdd3dd982b",
      "migrations_dir": "migrations"
    }
  ]
}
